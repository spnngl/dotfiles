[user]
	name = Lola Delannoy
	email = ldelannoy@wiremind.io
    signingkey = CADE17CA304170A9
[commit]
	gpgsign = false
    #template = "~/.config/git/msg"
[rerere]
    enabled = true
    autoUpdate = true
[status]
    relativePaths = false
    branch = true
[branch]
	autosetuprebase = always
[alias]
    d = diff
    st = status --short
    ci = commit
    co = checkout
    b = branch
    last = log -1 HEAD
[core]
    editor = /bin/nvim
    autocrlf = input
    whitespace = trailing-space
    excludesFile = ~/.config/git/ignore
[color]
    ui = true
[difftool]
	prompt = false
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
    ff   = no
[gpg]
	program = /usr/bin/gpg
[init]
	defaultBranch = main
