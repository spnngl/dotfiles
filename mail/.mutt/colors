# vim: filetype=muttrc

# color object      fg              bg
color normal        brightwhite     default
color error         color160        red
color tilde         color235        default
color message       white           default
color markers       color160        default
color attachment    color254        default
color search        color61         default
#color status        J_black         J_status
color status        color241        default
color indicator     color235        color130
color tree          color136        default                                    # arrow in threads

# mail
color header     color130               default         ".*"
# Highlight the relevant elements in the diff
#color body       green                  default         "^diff \-.*"
#color body       green                  default         "^index [a-f0-9].*"
#color body       green                  default         "^\-\-\- .*"
#color body       green                  default         "^[\+]{3} .*"
color body       green                  default         "^[\+][^\+]+.*"
color body       red                    default         "^\-[^\-]+.*"
#color body       brightblue             default         "^@@ .*"

# URLs
color body brightblue  black "(http|ftp|news|telnet|finger)://[^ \"\t\r\n]*"
color body brightblue  black "mailto:[-a-z_0-9.]+@[-a-z_0-9.]+"
mono  body bold              "(http|ftp|news|telnet|finger)://[^ \"\t\r\n]*"
mono  body bold              "mailto:[-a-z_0-9.]+@[-a-z_0-9.]+"
